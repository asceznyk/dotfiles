set $mod Mod4
set $term kitty
set $browser brave

input * {
  xkb_layout us
}

output eDP-1 scale 1.0

exec_always mako
exec_always swaybg -i ~/pictures/thumb_st_jp3.jpg -m fill
exec_always --no-startup-id swayosd-server
exec_always systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_CURRENT_DESKTOP

workspace_layout tabbed

default_border pixel 2
default_floating_border pixel 2
for_window [class=".*"] border pixel 2

client.focused #268bd2 #268bd2 #fdf6e3 #268bd2 #268bd2
client.focused_inactive #073642 #073642 #839496 #073642 #073642
client.unfocused #073642 #073642 #839496 #073642 #073642

floating_modifier $mod normal

font pango:monospace 11

titlebar_padding 5 1
titlebar_border_thickness 0

exec nm-applet --indicator

floating_modifier $mod

bindsym $mod+Space exec rofi -show drun
bindsym $mod+w exec networkmanager_dmenu
bindsym $mod+k exec rofi -dmenu -i -p "Keybinds" < ~/.config/sway/keybinds.txt

bindsym $mod+Return exec $term
bindsym $mod+b exec $browser

bindsym $mod+q kill

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+t layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split

bindsym $mod+o floating toggle
bindsym $mod+Semicolon focus mode_toggle

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+Shift+p exec shutdown now

mode "resize" {
  bindsym Left resize shrink width 10 px
  bindsym Down resize grow height 10 px
  bindsym Up resize shrink height 10 px
  bindsym Right resize grow width 10 px
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

bar {
  font pango:monospace 10
  separator_symbol "  "
  position bottom
  height 25
  status_command i3status
  colors {
    background #000000
    statusline #839496
    focused_workspace #268bd2 #268bd2 #fdf6e3
    active_workspace #268bd2 #268bd2 #002b36
    inactive_workspace #073642 #073642 #839496
    urgent_workspace #dc322f #dc322f #fdf6e3
  }
}

input type:touchpad {
  tap enabled
  natural_scroll enabled
  scroll_method two_finger
  middle_emulation enabled
  pointer_accel 1
}

input "*" {
  pointer_accel 1
  scroll_factor 3
}

bindsym F3 exec swayosd-client --output-volume raise
bindsym F2 exec swayosd-client --output-volume lower
bindsym F1 exec swayosd-client --output-volume mute-toggle

bindsym F4 exec swayosd-client --brightness lower
bindsym F5 exec swayosd-client --brightness raise

bindsym F9 exec swayosd-client --input-volume mute-toggle

bindsym Print exec grim ~/pictures/shot_$(date +%s).png 
bindsym Shift+Print exec grim -g "$(slurp)" ~/pictures/shot_$(date +%s).png

