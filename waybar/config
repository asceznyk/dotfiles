{
  "layer": "top",
  "position": "bottom",
  "height": 25,
  "spacing": 0,
  "exclusive": true,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "battery",
    "temperature",
    "cpu",
    "memory",
    "disk",
    "clock"
  ],
  "ext/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 3
    }
  },
  "bluetooth": {
    "format": "BT: {status}",
    "format-disabled": "BT: off",
    "format-off": "BT: off",
    "format-on": "BT: on",
    "format-connected": "BT: {device_alias}",
    "format-connected-battery": "BT: {device_alias}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 5
  },
  "clock": {
    "format": "datetime: {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": "NET: {essid}/{ipaddr}",
    "format-ethernet": "NET: ethernet",
    "format-disconnected": "NET: offline"
  },
  "disk": {
    "path": "/",
    "format": "disk: {used}/{total}"
  },
  "cpu": {
    "interval": 1,
    "format": "cpu: {usage}%"
  },
  "memory": {
    "interval": 1,
    "format": "mem: {used}GiB/{total}GiB"
  },
  "temperature": {
    "interval": 5,
    "thermal-zone": 0,
    "critical-threshold": 80,
    "format": "temp: {temperatureC}°C",
    "format-critical": "temp: {temperatureC}°C"
  },
  "battery": {
    "interval": 1,
    "states": {
      "warning": 20,
      "critical": 5
    },
    "format": "BAT: {capacity}%",
    "format-warning": "LOW: {capacity}%",
    "format-critical": "MIN: {capacity}%",
    "format-full": "MAX: 100%",
    "format-charging": "CHR: {capacity}%"
  }
}
