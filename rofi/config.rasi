* {
  base03: #000000;
  base02: #002b36;
  base01: #073642;
  base00: #657b83;
  base0: #839496;
  base1: #4d5a5b;
  base2: #073642;
  cyan: #d33682;
  green: #859900;
  orange: #cb4b16;
  magenta: #d33682;
  violet: #6c71c4;
  red: #dc322f;
  yellow: #b58900;
  blue: #268bd2;
  white: #fdf6e3;
  font: "monospace 12";
  show-icons: true;
  foreground: @base0;
  background: @base03;
  active-background: @base02;
  active-foreground: @white;
  prompt-foreground: @yellow;
  urgent-background: @base00;
  muted-foreground: @cyan;
  selected-foreground: @active-foreground;
  selected-background: @active-background;
  selected-urgent-background: @urgent-background;
  selected-active-background: @active-background;
  selected-active-foreground: @active-foreground;
  separatorcolor: @blue;
  bordercolor: @base02;
}

#window {
  background-color: @background;
  border: 2;
  border-radius: 0;
  border-color: @bordercolor;
  padding: 0;
}

#mainbox {
  border: 0;
  padding: 0;
}

#textbox {
  text-color: @selected-foreground;
}

#listview {
  border: 2px dash 0px 0px;
  border-color: @separatorcolor;
  scrollbar: false;
  padding: 0;
  margin-bottom: 5px;
  spacing: 0;
}

#element {
  border: 0;
  padding: 1px 5px;
}

#element.normal.normal {
  background-color: @background;
  text-color: @foreground;
}

#element.alternate.normal {
  background-color: @background;
  text-color: @foreground;
}

#element.normal.urgent {
  background-color: @urgent-background;
  text-color: @foreground;
}

#element.normal.active {
  background-color: @active-background;
  text-color: @active-foreground;
}

#element.selected.normal {
  background-color: @active-background;
  text-color: @active-foreground;
}

#element.selected.urgent {
  background-color: @selected-urgent-background;
  text-color: @foreground;
}

#element.selected.active {
  background-color: @selected-active-background;
  text-color: @selected-active-foreground;
}

#element.alternate.urgent {
  background-color: @urgent-background;
  text-color: @foreground;
}

#element.alternate.active {
  background-color: @active-background;
  text-color: @foreground;
}

#sidebar {
  border: 2px dash 0px 0px;
  border-color: @separatorcolor;
}

#button.selected {
  background-color: @selected-background;
  text-color: @foreground;
}

#inputbar {
  spacing: 0;
  text-color: @selected-foreground;
  padding: 3 5px;
}

#case-indicator {
  spacing: 0;
  text-color: @foreground;
}

#entry {
  spacing: 0;
  text-color: @foreground;
  placeholder: "type something..";
  placeholder-color: @muted-foreground;
  cursor-width: 2px;
  cursor-color: @muted-foreground;
}

#prompt {
  spacing: 0;
  text-color: @prompt-foreground;
}

#textbox-prompt-colon {
  expand: false;
  str: ":";
  margin: 0px 0.2em 0em 0em;
  text-color: @prompt-foreground;
}

#inputbar {
  children: [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

