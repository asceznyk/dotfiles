input {
  keyboard {
    xkb {
      layout "us"
    }
  }
  touchpad {
    tap
    dwt
    dwtp
    drag false
    drag-lock
    natural-scroll
  }
  mouse {
    accel-speed 1.0
    scroll-method "no-scroll"
  }
  trackpoint {
    accel-speed 1.0
    scroll-button-lock
    middle-emulation
  }
}

output "eDP-1" {
  mode "1920x1080@120.030"
  scale 1.0
  transform "normal"
}

blur {
  passes 3
  offset 3
  saturation 1.5
}

layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
  background-effect {
    blur true
  }
}

layout {
  background-color "transparent"
  gaps 0
  center-focused-column "never"
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }
  default-column-width { proportion 0.5; }
  focus-ring {
    off
  }
  border {
    width 2
    active-color "#268bd2"
    inactive-color "#002b36"
    urgent-color "#dc322f"
  }
  shadow {
    off
  }
}

overview {
  zoom 0.6
  workspace-shadow {
    off
  }
}

spawn-at-startup "waybar"
spawn-sh-at-startup "swayosd-server"
spawn-sh-at-startup "swaybg -i ~/pictures/thumb_st_jp3_saturated.jpg -m fill"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_CURRENT_DESKTOP"

hotkey-overlay {
  skip-at-startup
}

prefer-no-csd

screenshot-path "~/pictures/screenshot_from_%Y_%m_%d_%H_%M_%S.png"

animations {
  slowdown 0.3
}

window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.gnome\.World\.Secrets$"#
  block-out-from "screen-capture"
}

window-rule {
  geometry-corner-radius 0
  opacity 1.0
}

window-rule {
  match is-focused=false
  opacity 0.93
  background-effect {
    blur true
  }
}

binds {
  Mod+K { spawn-sh "rofi -dmenu -i -p 'Keybinds' < ~/.config/niri/keybinds.txt"; }
  Mod+B hotkey-overlay-title="Open a Browser" { spawn "brave"; }
  Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "kitty"; }
  Mod+Space hotkey-overlay-title="Run an Application" { spawn "rofi" "-show" "drun"; }
  Mod+W { spawn-sh "networkmanager_dmenu"; }
  F3 { spawn-sh "swayosd-client --output-volume raise"; }
  F2 { spawn-sh "swayosd-client --output-volume lower"; }
  F1 { spawn-sh "swayosd-client --output-volume mute-toggle"; }
  F5 { spawn-sh "swayosd-client --brightness raise"; }
  F4 { spawn-sh "swayosd-client --brightness lower"; }
  F9 { spawn-sh "swayosd-client --input-volume mute-toggle"; }
  Mod+O repeat=false { toggle-overview; }
  Mod+Q repeat=false { close-window; }
  Mod+Left  { focus-column-left; }
  Mod+Down  { focus-window-down; }
  Mod+Up    { focus-window-up; }
  Mod+Right { focus-column-right; }
  Mod+Shift+Left  { move-column-left; }
  Mod+Shift+Down  { move-window-down; }
  Mod+Shift+Up    { move-window-up; }
  Mod+Shift+Right { move-column-right; }
  Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
  Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
  Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; }
  Mod+BracketLeft  { consume-or-expel-window-left; }
  Mod+BracketRight { consume-or-expel-window-right; }
  Mod+Comma  { consume-window-into-column; }
  Mod+Period { expel-window-from-column; }
  Mod+M { maximize-column; }
  Mod+C { center-column; }
  Mod+Minus { set-column-width "-10%"; }
  Mod+Equal { set-column-width "+10%"; }
  Mod+Shift+Minus { set-window-height "-10%"; }
  Mod+Shift+Equal { set-window-height "+10%"; }
  Mod+V       { toggle-window-floating; }
  Print { screenshot-screen; }
  Ctrl+Print { screenshot; }
  Alt+Print { screenshot-window; }
  Mod+Shift+E { quit; }
  Mod+Shift+P { spawn-sh "shutdown now"; }
}

